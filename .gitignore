# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Build output
dist/
*.tsbuildinfo

# Electron release artifacts
desktop-client/release/
desktop-client/dist-electron/

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Testing
coverage/
.nyc_output/
desktop-client/test-results/
# Outputs of past tests/e2e/codex-runtime.ts runs. That test instructs a real
# Codex agent to create the file and verifies it via the fetched remote ref, so
# nothing reads the local copy — but a tracked leftover turns the agent's
# "create this" instruction into "modify this" while the same prompt forbids
# modifying other tracked files.
tests/fixtures/afk-codex-e2e-*.txt

# Logs
*.log

# Temporary files
*.tmp
.afk-signal.json
.afk/

# Desktop client dev artifacts
desktop-client/.dev/

# Redis dump
dump.rdb

# Git worktrees
.worktrees/
.playwright-mcp/
.playwright-cli/

# Agent working state is local; settings.json is shared so the team gets
# the same hooks. settings.local.json stays ignored.
.claude/*
!.claude/settings.json

# jev-agent-guard host configs are generated per machine and embed absolute
# paths (e.g. /Users/<name>/...), so they cannot be shared.
.codex/
.opencode/

# Agent runtime state
.omo/
