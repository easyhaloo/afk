#!/usr/bin/env sh
# husky pre-push hook

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

failed=0

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ -z "$branch" ] || [ "$branch" != "main" ] && [[ ! "$branch" =~ ^release/ ]]; then
    exit 0
fi

echo "\n${YELLOW}Running pre-push checks (docs:check → architecture:check → typecheck → build → test → desktop)${NC}"

pnpm run docs:check         || { echo "${RED}Docs link check failed${NC}";   failed=1; }
pnpm run architecture:check || { echo "${RED}Architecture check failed${NC}"; failed=1; }
pnpm run typecheck         || { echo "${RED}Type check failed${NC}";       failed=1; }
pnpm run build             || { echo "${RED}Build failed${NC}";             failed=1; }
pnpm run test              || { echo "${RED}Tests failed${NC}";              failed=1; }

# The desktop client is a workspace of this repository, and its renderer
# bundle is built by its own toolchain. A green root run said nothing
# about it: a change that broke the renderer's bundle still passed every
# check above, because none of them built it.
if [ -d desktop-client ]; then
  cd desktop-client || { echo "${RED}Desktop client directory is unreadable${NC}"; failed=1; }
  pnpm run typecheck || { echo "${RED}Desktop type check failed${NC}"; failed=1; }
  pnpm run test      || { echo "${RED}Desktop tests failed${NC}";      failed=1; }
  pnpm run build     || { echo "${RED}Desktop build failed${NC}";     failed=1; }
  cd .. || { echo "${RED}Could not leave the desktop client directory${NC}"; failed=1; }
fi

[ $failed -eq 1 ] && exit 1 || exit 0
