#!/usr/bin/env sh
# husky pre-push hook
#
# Two tiers. Every run states which tier it used, what it ran, and what it
# skipped:
#
#   full     main and release/*  - every check in the repository: docs:check,
#                                  architecture:check, typecheck, build, test,
#                                  and the desktop client's own typecheck /
#                                  test / build.
#   feature  any other branch    - the checks that are cheap enough to run on
#                                  every push: docs:check, architecture:check,
#                                  typecheck. build, test and the desktop
#                                  steps are skipped there - they are too slow
#                                  to run on every feature-branch push.
#
# The old hook exited 0 on every branch that was not main or release/*, so the
# guardrails were switched off exactly where the work happens. The feature
# tier now runs what is cheap enough to always run, and says out loud what it
# left out.
#
# Verification aid: AFK_PRE_PUSH_BRANCH overrides the branch name the hook
# reports, so the full tier can be exercised without checking out main.

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
DIM='\033[2m'
NC='\033[0m'

failed=0
failed_list=""

branch=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ -n "${AFK_PRE_PUSH_BRANCH:-}" ]; then
    branch="$AFK_PRE_PUSH_BRANCH"
fi

case "$branch" in
    main)
        tier="full"
        reason="branch 'main' is a protected branch"
        ;;
    release/*)
        tier="full"
        reason="branch '$branch' is a release branch"
        ;;
    "")
        tier="full"
        reason="detached HEAD - no branch to classify, so the full tier runs"
        ;;
    *)
        tier="feature"
        reason="branch '$branch' is neither 'main' nor 'release/*'"
        ;;
esac

branch_label="$branch"
if [ -z "$branch_label" ]; then
    branch_label="(detached HEAD)"
fi

if [ "$tier" = "full" ]; then
    runs="docs:check, architecture:check, typecheck, build, test, desktop typecheck, desktop test, desktop build"
    skips="nothing - the full tier runs every check"
else
    runs="docs:check, architecture:check, typecheck"
    skips="build, test, desktop typecheck, desktop test, desktop build - too slow for every feature-branch push (they run in CI and on main)"
fi

# step <label> <command...> - run one check, record its verdict.
step() {
    label=$1
    shift
    echo ""
    echo "  ${DIM}->${NC} ${label}"
    if "$@"; then
        echo "  ${GREEN}ok${NC}: ${label}"
    else
        echo "  ${RED}FAILED${NC}: ${label}"
        failed_list="$failed_list $label"
        failed=1
    fi
}

echo ""
echo "${YELLOW}Pre-push checks - tier: ${tier}${NC}"
echo "  ${DIM}branch:${NC}  ${branch_label}"
echo "  ${DIM}why:${NC}     ${reason}"
echo "  ${DIM}runs:${NC}    ${runs}"
echo "  ${DIM}skips:${NC}   ${skips}"

step "docs:check" pnpm run docs:check
step "architecture:check" pnpm run architecture:check
step "typecheck" pnpm run typecheck

if [ "$tier" = "full" ]; then
    step "build" pnpm run build
    step "test" pnpm run test

    # The desktop client is a workspace of this repository, and its renderer
    # bundle is built by its own toolchain. A green root run said nothing
    # about it: a change that broke the renderer's bundle still passed every
    # check above, because none of them built it.
    if [ -d desktop-client ]; then
        if cd desktop-client; then
            step "desktop typecheck" pnpm run typecheck
            step "desktop test" pnpm run test
            step "desktop build" pnpm run build
            cd .. || { echo "${RED}Could not leave the desktop client directory${NC}"; failed=1; }
        else
            echo "${RED}Desktop client directory is unreadable${NC}"
            failed=1
        fi
    else
        echo "  ${DIM}->${NC} desktop checks skipped: no desktop-client directory"
    fi
fi

echo ""
if [ "$failed" -eq 1 ]; then
    echo "${RED}Pre-push checks FAILED (tier: ${tier}):${failed_list}${NC}"
    echo "${RED}push rejected - fix the checks above, or push with --no-verify if you know what you are doing${NC}"
    exit 1
fi

echo "${GREEN}Pre-push checks passed (tier: ${tier}, branch: ${branch_label})${NC}"
exit 0
