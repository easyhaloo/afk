{
  "name": "afk-control-electron",
  "version": "0.1.0",
  "private": true,
  "description": "AFK Control local desktop client",
  "main": "dist-electron/electron/main.js",
  "type": "module",
  "scripts": {
    "dev:main": "node scripts/build-main.mjs --watch",
    "dev:raw": "pnpm build:main && concurrently -k \"pnpm run dev:main\" \"vite --port ${AFK_CONTROL_PORT:-5174} --strictPort\" \"wait-on tcp:${AFK_CONTROL_PORT:-5174} && ELECTRON_RENDERER_URL=http://localhost:${AFK_CONTROL_PORT:-5174} electron .\"",
    "dev": "pnpm run dev:raw",
    "start": "bash scripts/start.sh",
    "build:application": "pnpm --filter @afk/runtime... build",
    "typecheck": "pnpm build:application && tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "pnpm build:application && node scripts/build-provider-inventory.mjs && vitest run --config vitest.config.ts",
    "test:contrast": "playwright test --config=playwright.config.ts contrast",
    "shots": "playwright test --config=playwright.config.ts reskin-shots",
    "e2e": "playwright test --config=playwright.config.ts",
    "build:main": "pnpm build:application && node scripts/build-provider-inventory.mjs && node scripts/build-main.mjs",
    "build": "pnpm typecheck && pnpm build:main && vite build",
    "package:mac": "pnpm build && electron-builder --mac dmg zip",
    "verify:mac": "bash scripts/restart-packaged-mac.sh",
    "prepare": "husky",
    "package:win": "pnpm build && electron-builder --win nsis",
    "package:linux": "pnpm build && electron-builder --linux AppImage deb"
  },
  "build": {
    "appId": "im.afk.control",
    "productName": "AFK Control",
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/**",
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "icon": "assets/afk-control.png",
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/afk-control.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "minimumSystemVersion": "12.0"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Development",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "js-yaml": "^5.3.0",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "node-pty": "1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@afk/application": "workspace:*",
    "@afk/core": "workspace:*",
    "@playwright/test": "1.62.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "husky": "^9.1.7",
    "react-test-renderer": "19.2.8",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^1.6.1",
    "wait-on": "^8.0.1",
    "@afk/runtime": "workspace:*",
    "esbuild": "^0.21.5"
  }
}
