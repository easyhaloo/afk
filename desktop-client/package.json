{
  "name": "afk-control-electron",
  "version": "0.1.0",
  "private": true,
  "description": "AFK Control local desktop client",
  "main": "dist-electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:main": "tsc -p tsconfig.electron.json --watch",
    "dev": "concurrently -k \"pnpm dev:main\" \"vite --port 5174\" \"wait-on tcp:5174 file:dist-electron/main.js && ELECTRON_RENDERER_URL=http://localhost:5174 electron .\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "build:main": "tsc -p tsconfig.electron.json",
    "build": "pnpm typecheck && pnpm build:main && vite build",
    "package:mac": "pnpm build && electron-builder --mac --dir"
  },
  "build": {
    "appId": "im.afk.control",
    "productName": "AFK Control",
    "directories": { "output": "release" },
    "files": ["dist/**", "dist-electron/**", "package.json"],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dir"],
      "minimumSystemVersion": "12.0"
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
