{
  "name": "afk",
  "version": "0.1.0",
  "description": "Unified CLI for AFK (Automated Feature Kitchen) workflow",
  "type": "module",
  "bin": {
    "afk": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/fix-esm-extensions.mjs",
    "dev": "tsc --watch",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "afk",
    "gitlab",
    "automation",
    "ci-cd"
  ],
  "dependencies": {
    "@gitbeaker/node": "^35.8.0",
    "bullmq": "^5.1.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "express": "^4.18.2",
    "ink": "^7.1.1",
    "ioredis": "^5.3.2",
    "js-yaml": "^5.2.2",
    "node-tmux": "^1.0.2",
    "open": "^11.0.0",
    "react": "^19.2.8",
    "simple-git": "^3.22.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/open": "^6.1.0",
    "@types/react": "^19.2.17",
    "esbuild": "^0.21.5",
    "figures": "^6.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
