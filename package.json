{
  "name": "afk",
  "version": "0.1.0",
  "description": "Away From Keyboard — autonomous development workflow CLI + Skills system",
  "type": "module",
  "bin": {
    "afk": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest",
    "postinstall": "node scripts/fix-permissions.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "afk",
    "gitlab",
    "automation",
    "ci-cd"
  ],
  "dependencies": {
    "@gitbeaker/node": "^35.8.0",
    "@m234/nerd-fonts": "^0.5.1",
    "@octokit/rest": "^22.0.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "conf": "^12.0.0",
    "express": "^4.18.2",
    "ink": "^7.1.1",
    "js-yaml": "^5.2.2",
    "node-tmux": "^1.0.2",
    "open": "^11.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.2.8",
    "simple-git": "^3.22.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/open": "^6.1.0",
    "@types/react": "^19.2.17",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "esbuild": "^0.21.5",
    "figures": "^6.1.0",
    "glob": "^13.0.6",
    "node-pty": "^1.1.0",
    "puppeteer": "21.10.0",
    "strip-ansi": "^7.2.0",
    "terminal-screenshot": "^1.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "xterm": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "node-pty",
      "puppeteer"
    ]
  }
}
