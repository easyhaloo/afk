{
  "name": "afk-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"!afk-control-electron\" build",
    "typecheck": "pnpm --filter @afk/runtime... build && pnpm -r --filter \"!afk-control-electron\" typecheck && tsc -p tsconfig.tests.json",
    "architecture:check": "node scripts/architecture-guard.mjs --check-packages && node scripts/check-workspace-imports.mjs",
    "application:typecheck": "pnpm --filter @afk/application typecheck",
    "application:build": "pnpm --filter @afk/application build",
    "application:test": "pnpm --filter @afk/application test",
    "docs:check": "node scripts/check-doc-links.mjs",
    "dev": "pnpm --filter afk dev",
    "pretest": "npm run build",
    "test": "pnpm -r --filter \"!afk-control-electron\" test && vitest run",
    "test:e2e:codex": "tsx tests/e2e/codex-runtime.ts",
    "test:e2e:claude": "pnpm build && AFK_REAL_CLAUDE_E2E=1 pnpm --filter afk exec vitest run src/tui/task-runtime.integration.test.ts src/tui/task-runtime.sandbox-integration.test.ts --no-file-parallelism",
    "test:e2e:pty": "vitest run --config vitest.pty.config.ts",
    "test:e2e:cli": "pnpm build && vitest run tests/e2e/cli-workflow.test.ts",
    "test:e2e": "pnpm test:e2e:cli && pnpm test:e2e:pty && pnpm --filter afk-control-electron e2e",
    "test:watch": "vitest",
    "postinstall": "node scripts/fix-permissions.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/open": "^6.1.0",
    "@types/react": "^19.2.17",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ansi-to-html": "^0.7.2",
    "esbuild": "^0.21.5",
    "figures": "^6.1.0",
    "glob": "^13.0.6",
    "node-pty": "^1.1.0",
    "puppeteer": "21.10.0",
    "strip-ansi": "^7.2.0",
    "terminal-screenshot": "^1.1.0",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "xterm": "^5.3.0",
    "@afk/runtime": "workspace:*",
    "@afk/application": "workspace:*",
    "@afk/core": "workspace:*",
    "commander": "^12.0.0",
    "react": "^19.2.8",
    "simple-git": "^3.22.0",
    "ink": "^7.1.1"
  }
}
