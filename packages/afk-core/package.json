{
  "name": "@afk/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AFK business core — pure domain models, events, reducer, policy and ports. No Node.js/Electron/React/Provider dependencies.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
