{
  "name": "@afk/execution",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AFK execution runtime \u2014 the work item execution, workflow and agent runtime behind the @afk/application use cases.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./application/plugins/runtime": {
      "types": "./dist/application/plugins/runtime.d.ts",
      "import": "./dist/application/plugins/runtime.js"
    },
    "./domain/agents": {
      "types": "./dist/domain/agents/index.d.ts",
      "import": "./dist/domain/agents/index.js"
    },
    "./infrastructure/config/manager": {
      "types": "./dist/infrastructure/config/manager.d.ts",
      "import": "./dist/infrastructure/config/manager.js"
    },
    "./infrastructure/runtime/resource-registry": {
      "types": "./dist/infrastructure/runtime/resource-registry.d.ts",
      "import": "./dist/infrastructure/runtime/resource-registry.js"
    },
    "./infrastructure/sandbox": {
      "types": "./dist/infrastructure/sandbox/index.d.ts",
      "import": "./dist/infrastructure/sandbox/index.js"
    },
    "./infrastructure/sandbox/container": {
      "types": "./dist/infrastructure/sandbox/container/index.d.ts",
      "import": "./dist/infrastructure/sandbox/container/index.js"
    },
    "./infrastructure/sandbox/providers": {
      "types": "./dist/infrastructure/sandbox/providers/index.d.ts",
      "import": "./dist/infrastructure/sandbox/providers/index.js"
    },
    "./infrastructure/tmux": {
      "types": "./dist/infrastructure/tmux/index.d.ts",
      "import": "./dist/infrastructure/tmux/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@afk/application": "workspace:*",
    "@afk/core": "workspace:*",
    "@afk/infrastructure": "workspace:*",
    "js-yaml": "^5.2.2",
    "open": "^10.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "simple-git": "^3.22.0",
    "ws": "^8.21.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
