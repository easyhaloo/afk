{
  "name": "@afk/workflow-graph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./step-graph": {
      "types": "./dist/step-graph.d.ts",
      "import": "./dist/step-graph.js"
    }
