# Target application
BASE_URL=http://localhost:8080

# Optional API-key authentication. The header name is configurable because
# applications use different contracts; do not assume this is the right auth.
# API_KEY=
# API_KEY_HEADER=X-API-Key

# storage-state mode only. Keep the generated file out of version control.
# AUTH_MODE=storage-state
# AUTH_STATE_FILE=playwright/.auth/user.json

# Add only the credential variables required by the discovered login flow.
# TEST_EMAIL=
# TEST_PASSWORD=

# localhost-cdp mode only. Use a dedicated Chromium profile and loopback URL.
# CDP_ENDPOINT=http://127.0.0.1:9222
