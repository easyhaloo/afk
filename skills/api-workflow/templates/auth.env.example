# Base URL for the target application
BASE_URL=http://localhost:8080

# --- storage-state mode ---
# Path to the auth state file (default: playwright/.auth/user.json)
# AUTH_STATE_FILE=

# API setup credentials
# TEST_EMAIL=
# TEST_PASSWORD=
# WIKI_API_KEY=

# UI setup credentials
# TEST_EMAIL=
# TEST_PASSWORD=

